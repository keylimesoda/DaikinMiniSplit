<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DaikinAndroid.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <!-- Loading State -->
        <StackPanel x:Name="LoadingPanel" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Loading schedule..." 
                       Style="{StaticResource BodyTextBlockStyle}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error State -->
        <StackPanel x:Name="ErrorPanel" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Spacing="16"
                    Padding="24">
            <FontIcon Glyph="&#xE7BA;" FontSize="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            <TextBlock x:Name="ErrorText" 
                       Text="Failed to load schedule" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
            <Button Content="Retry" 
                    HorizontalAlignment="Center"
                    Click="RetryButton_Click"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer x:Name="ContentPanel" Visibility="Collapsed">
            <StackPanel Spacing="16" Padding="8">

                <!-- HOME VIEW (Today's Schedule) -->
                <StackPanel x:Name="HomeViewPanel" Spacing="16">

                    <!-- Header with Enable Toggle -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Schedule" 
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        
                        <ToggleSwitch x:Name="EnableToggle"
                                      Grid.Column="1"
                                      OnContent="Enabled"
                                      OffContent="Paused"
                                      Toggled="EnableToggle_Toggled"/>
                    </Grid>

                    <!-- Next Up Card -->
                    <Border x:Name="NextUpCard"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            CornerRadius="8" 
                            Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⏰ NEXT UP" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon x:Name="NextEventIcon" 
                                          Glyph="&#xE9CA;" 
                                          FontSize="24" 
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="NextEventTime" 
                                                   Text="5:00 PM" 
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="→" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NextEventDescription" 
                                                   Text="Cool 72°F"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NextEventCountdown" 
                                               Text="in 2h 34m" 
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                <!-- No Next Event Message -->
                <Border x:Name="NoNextEventCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="20"
                        Visibility="Collapsed">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE787;" FontSize="32" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="No upcoming events" 
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                    <!-- Today's Schedule -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            CornerRadius="8" 
                            Padding="20">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock x:Name="TodayHeader" 
                                           Text="TODAY (Tuesday)" 
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                
                                <Button x:Name="ViewWeekButton"
                                        Grid.Column="1"
                                        Content="View Week"
                                        Click="ViewWeekButton_Click"
                                        Style="{StaticResource TextBlockButtonStyle}"/>
                            </Grid>
                            
                            <ItemsControl x:Name="TodayEventsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Text="{Binding StatusText}" 
                                                       Foreground="Green"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding TimeText}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Center"/>
                                            
                                            <StackPanel Grid.Column="2" 
                                                        Orientation="Horizontal" 
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="16"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource BodyTextBlockStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoEventsToday"
                                       Text="No events scheduled for today"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Info Banner -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                            CornerRadius="8" 
                            Padding="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE946;" 
                                      FontSize="16" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Schedules run on device — app can be closed after setup."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- WEEK VIEW -->
                <StackPanel x:Name="WeekViewPanel" Spacing="16" Visibility="Collapsed">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="BackButton"
                                Click="BackButton_Click"
                                VerticalAlignment="Center"
                                Padding="8,6"
                                Background="Transparent"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                                <TextBlock Text="This Week" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="4">
                        <Grid x:Name="DaySelectorGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            CornerRadius="8" 
                            Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SelectedDayHeader" 
                                       Text="TUESDAY" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            
                            <ItemsControl x:Name="SelectedDayEventsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Text="{Binding StatusText}" 
                                                       Foreground="Green"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding TimeText}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Center"/>
                                            
                                            <StackPanel Grid.Column="2" 
                                                        Orientation="Horizontal" 
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="16"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource BodyTextBlockStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoEventsSelectedDay"
                                       Text="No events scheduled"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tap a day to view its schedule"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
