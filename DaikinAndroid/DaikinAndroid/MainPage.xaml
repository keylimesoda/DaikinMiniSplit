<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DaikinAndroid.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DaikinAndroid"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar (Windows only - collapsed on other platforms via code-behind) -->
        <Grid x:Name="AppTitleBar" Height="32"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" x:Name="MainContentGrid" Padding="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: App Icon + Title + Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE9CA;" FontSize="28"/>
                    <TextBlock Text="Daikin Manager" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <!-- Subtle status dot -->
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="Gray"/>
                    <!-- Error icon (shown on connection loss) -->
                    <FontIcon x:Name="ErrorIcon" Glyph="&#xE7BA;" FontSize="14" Foreground="Crimson" Visibility="Collapsed" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Connection lost - retrying..."/>
                </StackPanel>
                
                <!-- Right: Power Button -->
                <Grid x:Name="PowerButton" 
                      Grid.Column="2"
                      Width="48" Height="48"
                      Margin="0,10,6,0"
                      VerticalAlignment="Top"
                      PointerEntered="PowerButton_PointerEntered"
                      PointerExited="PowerButton_PointerExited"
                      PointerPressed="PowerButton_PointerPressed"
                      ToolTipService.ToolTip="Toggle Power">
                    <Border x:Name="PowerButtonBackground" 
                            Background="Transparent" 
                            CornerRadius="6"/>
                    <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontSize="20" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Tab Bar -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="TabControls" Grid.Column="0" Click="Tab_Click" Tag="Controls"
                            HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="Transparent"
                            Padding="0,10" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9A1;" FontSize="16"/>
                            <TextBlock Text="Controls" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabSchedule" Grid.Column="1" Click="Tab_Click" Tag="Schedule"
                            HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="Transparent"
                            Padding="0,10" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE787;" FontSize="16"/>
                            <TextBlock Text="Schedule" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabDiagnostics" Grid.Column="2" Click="Tab_Click" Tag="Diagnostics"
                            HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="Transparent"
                            Padding="0,10" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16"/>
                            <TextBlock Text="Diagnostics" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Active tab indicator -->
                    <Border x:Name="TabIndicator" Grid.Column="0" Height="3" CornerRadius="1.5"
                            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Margin="12,0" Background="{StaticResource AccentBrush}"/>
                </Grid>

                <Frame x:Name="ContentFrame" Grid.Row="1"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
