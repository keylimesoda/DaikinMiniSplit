<Application x:Class="DaikinAndroid.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Custom App Resources -->
      <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4"/>
      <SolidColorBrush x:Key="PowerOnBrush" Color="#FF4CB450"/>
      <SolidColorBrush x:Key="PowerOffBrush" Color="#FF787878"/>
      <SolidColorBrush x:Key="CoolModeBrush" Color="#FF00BFFF"/>
      <SolidColorBrush x:Key="HeatModeBrush" Color="#FFFF4500"/>
      <SolidColorBrush x:Key="AutoModeBrush" Color="#FF3CB371"/>

    </ResourceDictionary>
  </Application.Resources>

</Application>
