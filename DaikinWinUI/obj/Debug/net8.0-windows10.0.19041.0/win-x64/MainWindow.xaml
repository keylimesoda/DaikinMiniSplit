<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DaikinManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DaikinManager"
    xmlns:controls="using:DaikinManager.Controls"
    Title="Daikin Manager">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <FontIcon Glyph="&#xE9CA;" FontSize="28"/>
            <TextBlock Text="Daikin Manager" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <Border x:ConnectionId='4' Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" 
                    CornerRadius="4" Padding="8,4" VerticalAlignment="Center" x:Name="StatusBadge">
                <TextBlock x:ConnectionId='5' x:Name="StatusText" Text="Connecting..." FontSize="12"/>
            </Border>
        </StackPanel>

        <!-- Main Content -->
        <NavigationView x:ConnectionId='2' Grid.Row="1" 
                        x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Top"
                                                                   >
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Controls" Tag="Controls">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9A1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="Diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:ConnectionId='3' x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>

