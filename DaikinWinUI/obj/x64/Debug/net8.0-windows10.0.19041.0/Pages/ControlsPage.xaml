<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DaikinManager.Pages.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DaikinManager.Pages"
    xmlns:controls="using:DaikinManager.Controls"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid>
        <!-- Loading State -->
        <StackPanel x:ConnectionId='2' x:Name="LoadingPanel" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Connecting to Daikin..." 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error State -->
        <StackPanel x:ConnectionId='3' x:Name="ErrorPanel" 
                    Visibility="Collapsed"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Spacing="16">
            <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            <TextBlock Text="Unable to connect" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:ConnectionId='14' x:Name="ErrorMessage" 
                       Text="Check that the device is online" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>
            <Button x:ConnectionId='15' x:Name="RetryButton" Content="Retry"                           HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Controls (hidden until connected) -->
        <ScrollViewer x:ConnectionId='4' x:Name="ControlsPanel" Visibility="Collapsed">
            <StackPanel Spacing="16" Padding="8">
            
                <!-- Power Toggle (Live - applies immediately) -->
                <Button x:ConnectionId='5' x:Name="PowerButton" 
                        HorizontalAlignment="Stretch" 
                        Height="60"
                                                 >
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:ConnectionId='12' x:Name="PowerIcon" Glyph="&#xE7E8;" FontSize="24"/>
                        <TextBlock x:ConnectionId='13' x:Name="PowerText" Text="POWER: OFF" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Staged Controls (require Apply Settings) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                    
                        <!-- Temperature Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Temperature" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        
                            <!-- Mode Selector -->
                            <ComboBox x:ConnectionId='9' x:Name="ModeComboBox" 
                                      Header="Mode" 
                                      HorizontalAlignment="Stretch"
                                                                                      >
                                <ComboBoxItem Content="Cool" Tag="Cool"/>
                                <ComboBoxItem Content="Heat" Tag="Heat"/>
                                <ComboBoxItem Content="Auto" Tag="Auto"/>
                                <ComboBoxItem Content="Dry" Tag="Dry"/>
                                <ComboBoxItem Content="Fan" Tag="Fan"/>
                            </ComboBox>
                        
                            <!-- Temperature Dial -->
                            <Grid Height="200" Margin="0,8">
                                <controls:TemperatureDial x:ConnectionId='11' x:Name="TempDial" 
                                                           MinTemperature="60" 
                                                           MaxTemperature="90"
                                                           Temperature="72"/>
                            </Grid>
                        
                            <!-- Actual Temperature -->
                            <TextBlock x:ConnectionId='10' x:Name="ActualTempText" 
                                       Text="Actual: --°F" 
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- Fan & Swing Section -->
                        <StackPanel Spacing="16">
                            <ComboBox x:ConnectionId='7' x:Name="FanComboBox" Header="Fan Speed" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Auto" Tag="Auto"/>
                                <ComboBoxItem Content="Quiet" Tag="Quiet"/>
                                <ComboBoxItem Content="Level 3" Tag="Level3"/>
                                <ComboBoxItem Content="Level 4" Tag="Level4"/>
                                <ComboBoxItem Content="Level 5" Tag="Level5"/>
                                <ComboBoxItem Content="Level 6" Tag="Level6"/>
                                <ComboBoxItem Content="Level 7" Tag="Level7"/>
                            </ComboBox>
                        
                            <ComboBox x:ConnectionId='8' x:Name="SwingComboBox" Header="Swing" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Stopped" Tag="Stopped"/>
                                <ComboBoxItem Content="Vertical" Tag="Vertical"/>
                                <ComboBoxItem Content="Horizontal" Tag="Horizontal"/>
                                <ComboBoxItem Content="3D / Both" Tag="Both"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Apply Button -->
                        <Button x:ConnectionId='6' x:Name="ApplyButton" 
                                Content="APPLY SETTINGS" 
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="50"
                                                         />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

