<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DaikinManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DaikinManager"
    xmlns:controls="using:DaikinManager.Controls"
    Title="Daikin Manager">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar (draggable area) -->
        <Grid x:ConnectionId='2' x:Name="AppTitleBar" Height="32"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                <FontIcon Glyph="&#xE9CA;" FontSize="28"/>
                <TextBlock Text="Daikin Manager" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                <Border x:ConnectionId='5' Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" 
                        CornerRadius="4" Padding="8,4" VerticalAlignment="Center" x:Name="StatusBadge">
                    <TextBlock x:ConnectionId='6' x:Name="StatusText" Text="Connecting..." FontSize="12"/>
                </Border>
            </StackPanel>

            <!-- Navigation -->
            <NavigationView x:ConnectionId='3' Grid.Row="1" 
                            x:Name="NavView"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            PaneDisplayMode="Top"
                            Background="Transparent"
                                                                       >
                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Controls" Tag="Controls">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE9A1;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Diagnostics" Tag="Diagnostics">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE9D9;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Frame x:ConnectionId='4' x:Name="ContentFrame"/>
            </NavigationView>
        </Grid>
    </Grid>
</Window>

