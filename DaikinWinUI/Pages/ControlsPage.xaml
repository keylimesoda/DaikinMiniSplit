<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DaikinManager.Pages.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DaikinManager.Pages"
    xmlns:controls="using:DaikinManager.Controls"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid>
        <!-- Loading State -->
        <StackPanel x:Name="LoadingPanel" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Connecting to Daikin..." 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error State -->
        <StackPanel x:Name="ErrorPanel" 
                    Visibility="Collapsed"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Spacing="16">
            <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            <TextBlock Text="Unable to connect" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="ErrorMessage" 
                       Text="Check that the device is online" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>
            <Button x:Name="RetryButton" Content="Retry" Click="RetryButton_Click" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Controls (hidden until connected) -->
        <ScrollViewer x:Name="ControlsPanel" Visibility="Collapsed">
            <StackPanel Spacing="16" Padding="8">
            
                <!-- Power Toggle (Live - applies immediately) -->
                <Button x:Name="PowerButton" 
                        HorizontalAlignment="Stretch" 
                        Height="60"
                        Click="PowerButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontSize="24"/>
                        <TextBlock x:Name="PowerText" Text="POWER: OFF" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Staged Controls (require Apply Settings) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                    
                        <!-- Temperature Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Mode" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        
                            <!-- Mode Icon Buttons with Labels Below -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Cool = Frigid (cold thermometer) E9CA -->
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <ToggleButton x:Name="ModeCool" Click="ModeButton_Click" Tag="Cool"
                                                  ToolTipService.ToolTip="Cool" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                        <FontIcon Glyph="&#xE9CA;" FontSize="20"/>
                                    </ToggleButton>
                                    <TextBlock x:Name="ModeCoolLabel" Text="Cool" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Heat = Brightness (sun) E706 -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <ToggleButton x:Name="ModeHeat" Click="ModeButton_Click" Tag="Heat"
                                                  ToolTipService.ToolTip="Heat" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                        <FontIcon Glyph="&#xE706;" FontSize="20"/>
                                    </ToggleButton>
                                    <TextBlock x:Name="ModeHeatLabel" Text="Heat" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Auto = Sync (circular arrows) E895 -->
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <ToggleButton x:Name="ModeAuto" Click="ModeButton_Click" Tag="Auto"
                                                  ToolTipService.ToolTip="Auto" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                        <FontIcon Glyph="&#xE895;" FontSize="20"/>
                                    </ToggleButton>
                                    <TextBlock x:Name="ModeAutoLabel" Text="Auto" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Dry = Drop (water droplet) EB42 -->
                                <StackPanel Grid.Column="3" Spacing="4">
                                    <ToggleButton x:Name="ModeDry" Click="ModeButton_Click" Tag="Dry"
                                                  ToolTipService.ToolTip="Dry" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                        <FontIcon Glyph="&#xEB42;" FontSize="20"/>
                                    </ToggleButton>
                                    <TextBlock x:Name="ModeDryLabel" Text="Dry" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Fan = WindDirection (airflow) EBE6 -->
                                <StackPanel Grid.Column="4" Spacing="4">
                                    <ToggleButton x:Name="ModeFan" Click="ModeButton_Click" Tag="Fan"
                                                  ToolTipService.ToolTip="Fan Only" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                        <FontIcon Glyph="&#xEBE6;" FontSize="20"/>
                                    </ToggleButton>
                                    <TextBlock x:Name="ModeFanLabel" Text="Fan" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        
                            <!-- Temperature Dial -->
                            <Grid Height="250" Margin="0,8,0,0">
                                <controls:TemperatureDial x:Name="TempDial" 
                                                           MinTemperature="60" 
                                                           MaxTemperature="90"
                                                           Temperature="72"/>
                            </Grid>
                        
                            <!-- Actual Temperature -->
                            <TextBlock x:Name="ActualTempText" 
                                       Text="Actual: --°F" 
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,-20,0,8"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- Fan & Swing Section -->
                        <StackPanel Spacing="16">
                            <ComboBox x:Name="FanComboBox" Header="Fan Speed" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Auto" Tag="Auto"/>
                                <ComboBoxItem Content="Quiet" Tag="Quiet"/>
                                <ComboBoxItem Content="Level 3" Tag="Level3"/>
                                <ComboBoxItem Content="Level 4" Tag="Level4"/>
                                <ComboBoxItem Content="Level 5" Tag="Level5"/>
                                <ComboBoxItem Content="Level 6" Tag="Level6"/>
                                <ComboBoxItem Content="Level 7" Tag="Level7"/>
                            </ComboBox>
                        
                            <ComboBox x:Name="SwingComboBox" Header="Swing" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Stopped" Tag="Stopped"/>
                                <ComboBoxItem Content="Vertical" Tag="Vertical"/>
                                <ComboBoxItem Content="Horizontal" Tag="Horizontal"/>
                                <ComboBoxItem Content="3D / Both" Tag="Both"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Apply Button -->
                        <Button x:Name="ApplyButton" 
                                Content="APPLY SETTINGS" 
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="50"
                                Click="ApplyButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
