<Window
    x:Class="DaikinManagerV2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DaikinManagerV2"
    Title="Daikin Manager">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Padding="16,12,16,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE9CA;" FontSize="24"/>
                <TextBlock Text="Daikin Manager" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Status Badge + Countdown -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Connection Status Badge -->
                <Border x:Name="StatusBadge" 
                        Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" 
                        CornerRadius="4" 
                        Padding="10,5">
                    <TextBlock x:Name="StatusText" Text="Not Connected" FontSize="12"/>
                </Border>
                
                <!-- Refresh Countdown Indicator -->
                <ProgressRing x:Name="RefreshIndicator" 
                              Width="20" Height="20" 
                              IsIndeterminate="False"
                              Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,16">
                <ToggleButton x:Name="ControlsTab" 
                              Content="Controls" 
                              IsChecked="True" 
                              Click="Tab_Click"
                              Padding="16,8"
                              MinWidth="100"/>
                <ToggleButton x:Name="DiagnosticsTab" 
                              Content="Diagnostics" 
                              Click="Tab_Click"
                              Padding="16,8"
                              MinWidth="100"/>
            </StackPanel>

            <!-- Page Frame -->
            <Frame x:Name="ContentFrame" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
