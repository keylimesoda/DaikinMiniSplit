<Page
    x:Class="DaikinManagerV2.Views.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DaikinManagerV2.Views"
    xmlns:controls="using:DaikinManagerV2.Controls">

    <Page.Resources>
        <!-- Override checked-state background to match unchecked (no background color change on selection) -->
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource ControlFillColorDefault}"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource ControlFillColorSecondary}"/>
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource ControlFillColorTertiary}"/>
        
        <Style x:Key="NoBackgroundChangeToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading Panel - shown while connecting/loading initial data -->
        <StackPanel x:Name="LoadingPanel" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Spacing="16">
            <ProgressRing IsActive="True" Width="60" Height="60"/>
            <TextBlock Text="Connecting to Daikin unit..." 
                       HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock Text="Please wait while we fetch the current state"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        
        <!-- Error Panel - shown when connection/data fetch fails -->
        <StackPanel x:Name="ErrorPanel" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Spacing="16"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            <TextBlock Text="Connection Failed" 
                       HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock x:Name="ErrorMessageText"
                       Text="Unable to connect to the Daikin unit"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="300"/>
            <Button x:Name="RetryButton" 
                    Content="Retry" 
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="RetryButton_Click"/>
        </StackPanel>
        
        <!-- Controls Panel - only shown after successful connection AND data fetch -->
        <ScrollViewer x:Name="ControlsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Spacing="16" Padding="8">

            <!-- Staged Controls Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" 
                    Padding="16">
                <StackPanel Spacing="16">
            
                    <!-- Mode Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Mode" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Cool -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <ToggleButton x:Name="ModeCool" Checked="ModeButton_Checked" Unchecked="ModeButton_Unchecked" Tag="Cool"
                                              ToolTipService.ToolTip="Cool" Style="{StaticResource NoBackgroundChangeToggleButtonStyle}">
                                    <Border Width="20" Height="20">
                                        <Image x:Name="CoolIcon" Width="24" Height="24" Margin="-2" Stretch="Uniform">
                                            <Image.Source>
                                                <SvgImageSource UriSource="ms-appx:///Assets/snowflake.svg"/>
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                </ToggleButton>
                                <TextBlock x:Name="ModeCoolLabel" Text="Cool" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Heat -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <ToggleButton x:Name="ModeHeat" Checked="ModeButton_Checked" Unchecked="ModeButton_Unchecked" Tag="Heat"
                                              ToolTipService.ToolTip="Heat" Style="{StaticResource NoBackgroundChangeToggleButtonStyle}">
                                    <FontIcon x:Name="HeatIcon" Glyph="&#xE706;" FontSize="20"/>
                                </ToggleButton>
                                <TextBlock x:Name="ModeHeatLabel" Text="Heat" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Auto -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <ToggleButton x:Name="ModeAuto" Checked="ModeButton_Checked" Unchecked="ModeButton_Unchecked" Tag="Auto"
                                              ToolTipService.ToolTip="Auto" Style="{StaticResource NoBackgroundChangeToggleButtonStyle}">
                                    <FontIcon x:Name="AutoIcon" Glyph="&#xE793;" FontSize="20"/>
                                </ToggleButton>
                                <TextBlock x:Name="ModeAutoLabel" Text="Auto" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Dry -->
                            <StackPanel Grid.Column="3" Spacing="4">
                                <ToggleButton x:Name="ModeDry" Checked="ModeButton_Checked" Unchecked="ModeButton_Unchecked" Tag="Dry"
                                              ToolTipService.ToolTip="Dry" Style="{StaticResource NoBackgroundChangeToggleButtonStyle}">
                                    <Viewbox Width="40" Height="40" Margin="-10,-13.5,-10,-6.5" VerticalAlignment="Center">
                                        <TextBlock x:Name="DryIcon" Text="≋" FontSize="120"/>
                                    </Viewbox>
                                </ToggleButton>
                                <TextBlock x:Name="ModeDryLabel" Text="Dry" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Fan -->
                            <StackPanel Grid.Column="4" Spacing="4">
                                <ToggleButton x:Name="ModeFan" Checked="ModeButton_Checked" Unchecked="ModeButton_Unchecked" Tag="Fan"
                                              ToolTipService.ToolTip="Fan Only" Style="{StaticResource NoBackgroundChangeToggleButtonStyle}">
                                    <Image x:Name="FanModeIcon" Source="ms-appx:///Assets/fan.png" Width="20" Height="20"/>
                                </ToggleButton>
                                <TextBlock x:Name="ModeFanLabel" Text="Fan" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Temperature Section -->
                    <StackPanel x:Name="TemperatureSection" Spacing="8">
                        <!-- Temperature Dial in fixed height container -->
                        <Grid Height="250" Margin="0,8,0,0">
                            <controls:TemperatureDial x:Name="TempDial"
                                                      Temperature="72"
                                                      MinTemperature="64"
                                                      MaxTemperature="86"
                                                      Mode="Cool"
                                                      HorizontalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Fan Speed Control -->
                    <StackPanel x:Name="FanSpeedPanel" Spacing="12">
                        <!-- Header with Auto toggle - fixed height prevents toggle from expanding row -->
                        <Grid Height="20">
                            <TextBlock x:Name="FanSummaryText" Text="Fan: --" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel x:Name="AutoTogglePanel" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="AutoToggleLabel" Text="Auto" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ToggleSwitch x:Name="FanAutoToggle" 
                                              OnContent="" OffContent="" 
                                              MinWidth="40" MinHeight="20"
                                              Margin="0,-10,0,-10"
                                              VerticalAlignment="Center"
                                              Toggled="FanAutoToggle_Toggled"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Visual intensity bars (4 bars for 4 intensity levels) -->
                        <Grid x:Name="FanBarsGrid" Height="32" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="FanBar0" Grid.Column="0" Height="8" CornerRadius="4" Margin="0,0,3,0" VerticalAlignment="Bottom" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0"/>
                            <Border x:Name="FanBar1" Grid.Column="1" Height="16" CornerRadius="4" Margin="3,0,3,0" VerticalAlignment="Bottom" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0"/>
                            <Border x:Name="FanBar2" Grid.Column="2" Height="24" CornerRadius="4" Margin="3,0,3,0" VerticalAlignment="Bottom" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0"/>
                            <Border x:Name="FanBar3" Grid.Column="3" Height="32" CornerRadius="4" Margin="3,0,0,0" VerticalAlignment="Bottom" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0"/>
                        </Grid>
                        
                        <!-- Slider -->
                        <Slider x:Name="FanSpeedSlider" 
                                Minimum="0" Maximum="3" 
                                StepFrequency="1" 
                                SnapsTo="StepValues"
                                TickFrequency="1"
                            TickPlacement="None"
                                Value="0"
                                ValueChanged="FanSpeedSlider_ValueChanged"/>
                        
                        <!-- Labels under slider -->
                        <Grid x:Name="FanLabelsGrid" Margin="0,-8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="QuietLabel" Grid.Column="0" Text="Quiet" FontSize="13" HorizontalAlignment="Center" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="LowLabel" Grid.Column="1" Text="Low" FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="MediumLabel" Grid.Column="2" Text="Medium" FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="HighLabel" Grid.Column="3" Text="High" FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Swing Mode -->
                    <StackPanel x:Name="SwingSection" Spacing="8">
                        <TextBlock Text="Swing" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Off/Stopped -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <ToggleButton x:Name="SwingStopped" Checked="SwingButton_Checked" Unchecked="SwingButton_Unchecked" Tag="Off"
                                              ToolTipService.ToolTip="Off" Style="{StaticResource NoBackgroundChangeToggleButtonStyle}">
                                    <FontIcon x:Name="SwingStoppedIcon" Glyph="&#xF140;" FontSize="20"/>
                                </ToggleButton>
                                <TextBlock x:Name="SwingStoppedLabel" Text="Off" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Vertical -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <ToggleButton x:Name="SwingVertical" Checked="SwingButton_Checked" Unchecked="SwingButton_Unchecked" Tag="Vertical"
                                              ToolTipService.ToolTip="Vertical" Style="{StaticResource NoBackgroundChangeToggleButtonStyle}">
                                    <Grid Height="20">
                                        <StackPanel VerticalAlignment="Center" Spacing="-6">
                                            <FontIcon x:Name="SwingVerticalIcon1" Glyph="&#xE70E;" FontSize="14"/>
                                            <FontIcon x:Name="SwingVerticalIcon2" Glyph="&#xE70D;" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </ToggleButton>
                                <TextBlock x:Name="SwingVerticalLabel" Text="Vertical" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Horizontal -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <ToggleButton x:Name="SwingHorizontal" Checked="SwingButton_Checked" Unchecked="SwingButton_Unchecked" Tag="Horizontal"
                                              ToolTipService.ToolTip="Horizontal" Style="{StaticResource NoBackgroundChangeToggleButtonStyle}">
                                    <FontIcon x:Name="SwingHorizontalIcon" Glyph="&#xE8AB;" FontSize="20"/>
                                </ToggleButton>
                                <TextBlock x:Name="SwingHorizontalLabel" Text="Horizontal" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- 3D / Both -->
                            <StackPanel Grid.Column="3" Spacing="4">
                                <ToggleButton x:Name="SwingBoth" Checked="SwingButton_Checked" Unchecked="SwingButton_Unchecked" Tag="Both"
                                              ToolTipService.ToolTip="3D / Both" Style="{StaticResource NoBackgroundChangeToggleButtonStyle}">
                                    <FontIcon x:Name="SwingBothIcon" Glyph="&#xE744;" FontSize="20"/>
                                </ToggleButton>
                                <TextBlock x:Name="SwingBothLabel" Text="3D" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Apply Button -->
                    <Button x:Name="ApplyButton" 
                            Content="APPLY SETTINGS"
                            HorizontalAlignment="Stretch" 
                            Height="50"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ApplyButton_Click">
                    </Button>
                    
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
