<Page
    x:Class="DaikinManagerV2.Views.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DaikinManagerV2.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="8">
            
            <!-- Power Button (Live - applies immediately, outside card) -->
            <Button x:Name="PowerButton" 
                    HorizontalAlignment="Stretch" 
                    Height="60"
                    Click="PowerButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontSize="24"/>
                    <TextBlock x:Name="PowerText" Text="POWER: OFF" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Staged Controls Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" 
                    Padding="16">
                <StackPanel Spacing="16">
            
                    <!-- Mode Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Mode" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Cool -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <ToggleButton x:Name="ModeCool" Click="ModeButton_Click" Tag="Cool"
                                              ToolTipService.ToolTip="Cool" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                    <Image x:Name="CoolIcon" Width="20" Height="20">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/snowflake.svg"/>
                                        </Image.Source>
                                    </Image>
                                </ToggleButton>
                                <TextBlock x:Name="ModeCoolLabel" Text="Cool" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Heat -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <ToggleButton x:Name="ModeHeat" Click="ModeButton_Click" Tag="Heat"
                                              ToolTipService.ToolTip="Heat" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                    <FontIcon Glyph="&#xE706;" FontSize="20"/>
                                </ToggleButton>
                                <TextBlock x:Name="ModeHeatLabel" Text="Heat" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Auto -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <ToggleButton x:Name="ModeAuto" Click="ModeButton_Click" Tag="Auto"
                                              ToolTipService.ToolTip="Auto" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                    <FontIcon Glyph="&#xE793;" FontSize="20"/>
                                </ToggleButton>
                                <TextBlock x:Name="ModeAutoLabel" Text="Auto" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Dry -->
                            <StackPanel Grid.Column="3" Spacing="4">
                                <ToggleButton x:Name="ModeDry" Click="ModeButton_Click" Tag="Dry"
                                              ToolTipService.ToolTip="Dry" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                    <Viewbox Width="40" Height="40" Margin="-10,-13.5,-10,-6.5" VerticalAlignment="Center">
                                        <TextBlock Text="≋" FontSize="120"/>
                                    </Viewbox>
                                </ToggleButton>
                                <TextBlock x:Name="ModeDryLabel" Text="Dry" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Fan -->
                            <StackPanel Grid.Column="4" Spacing="4">
                                <ToggleButton x:Name="ModeFan" Click="ModeButton_Click" Tag="Fan"
                                              ToolTipService.ToolTip="Fan Only" Padding="8" HorizontalAlignment="Stretch" MinWidth="0">
                                    <Image Source="ms-appx:///Assets/fan.png" Width="20" Height="20"/>
                                </ToggleButton>
                                <TextBlock x:Name="ModeFanLabel" Text="Fan" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Temperature Section -->
                    <StackPanel x:Name="TemperatureSection" Spacing="8">
                        <TextBlock Text="Temperature" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        
                        <!-- Temperature Display -->
                        <TextBlock x:Name="SetTempText" 
                                   Text="72°F" 
                                   FontSize="48" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        
                        <!-- Temperature Slider -->
                        <Slider x:Name="TempSlider" 
                                Minimum="64" 
                                Maximum="86" 
                                StepFrequency="1"
                                ValueChanged="TempSlider_ValueChanged"
                                Margin="0,8,0,0"/>
                        
                        <!-- Actual Temperature -->
                        <TextBlock x:Name="ActualTempText" 
                                   Text="Actual: --°F" 
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Fan Speed -->
                    <ComboBox x:Name="FanComboBox" 
                              Header="Fan Speed" 
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FanComboBox_SelectionChanged">
                        <ComboBoxItem Content="Auto" Tag="Auto"/>
                        <ComboBoxItem Content="Quiet" Tag="Quiet"/>
                        <ComboBoxItem Content="Low" Tag="Low"/>
                        <ComboBoxItem Content="Medium" Tag="Medium"/>
                        <ComboBoxItem Content="High" Tag="High"/>
                    </ComboBox>

                    <!-- Swing Mode -->
                    <ComboBox x:Name="SwingComboBox" 
                              Header="Swing" 
                              HorizontalAlignment="Stretch"
                              SelectionChanged="SwingComboBox_SelectionChanged">
                        <ComboBoxItem Content="Stopped" Tag="Off"/>
                        <ComboBoxItem Content="Vertical" Tag="Vertical"/>
                        <ComboBoxItem Content="Horizontal" Tag="Horizontal"/>
                        <ComboBoxItem Content="3D / Both" Tag="Both"/>
                    </ComboBox>

                    <!-- Apply Button -->
                    <Button x:Name="ApplyButton" 
                            Content="APPLY SETTINGS"
                            HorizontalAlignment="Stretch" 
                            Height="50"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ApplyButton_Click">
                    </Button>
                    
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</Page>
